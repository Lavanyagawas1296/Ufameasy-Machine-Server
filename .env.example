UFAM_JWT_SECRET=replace-with-a-long-random-secret
UFAM_USER=replace-with-login-username
UFAM_PASS=replace-with-login-password
UFAM_CONTROL_PASS=replace-with-control-password
CUSTOMER_MODE=0
# Optional legacy on-premise backfill root; leave empty in cloud deployments.
UFAM_LEGACY_GCODE_ROOTS=
TRUST_PROXY_HEADERS=0
# Customer usage report
CUSTOMER_MACHINE_LABEL=
# Shift hours drawn on the report timeline (HH:MM, local time).
CUSTOMER_SHIFT_START=09:00
CUSTOMER_SHIFT_END=18:00
# 1 = show UFAMeasy operator names in the report and CSV (personal data; never in logs).
CUSTOMER_SHOW_OPERATOR=0
